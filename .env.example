# ---------------------------------------------------------------------------
# Supabase configuration
# ---------------------------------------------------------------------------
# This is a Next.js app, so browser-exposed variables must use the
# NEXT_PUBLIC_ prefix. Copy this file to `.env` (or `.env.local`) and paste
# your real Supabase project values. Until these are set, the app runs on
# built-in seed data.
#
# Find these values in your Supabase dashboard:
#   Project Settings -> API
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
